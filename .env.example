# Database
DATABASE_URL=postgresql://hrms_user:hrms_password@localhost:5432/hrms

# Node
NODE_ENV=development

# Auth
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=3000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (frontend dev server)
CORS_ORIGIN=http://localhost:3001

# Entra ID (placeholder, not implemented yet)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
