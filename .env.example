# Database
DATABASE_URL=postgresql://hrms_user:hrms_password@localhost:5432/hrms

# Node
NODE_ENV=development

# Auth
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=3000
API_PREFIX=/api/v1

# Entra ID (placeholder, not implemented yet)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# ===== SUPER ADMIN CONFIGURATION =====
# Comma-separated email addresses of Super Admin users
# These users will automatically get Super Admin role on login
SUPER_ADMIN_EMAILS=admin@company.com,hr-head@company.com

# Google/OAuth email-based Super Admins
SUPER_ADMIN_GOOGLE_IDS=admin@gmail.com,hr@gmail.com

# Phone-based Super Admins (for future SMS/phone authentication)
SUPER_ADMIN_PHONE_NUMBERS=

# Default role for Super Admins (if not specified in role mapping)
DEFAULT_SUPER_ADMIN_ROLE=Super Admin

# Security settings
ALLOW_SUPER_ADMIN_SELF_REMOVAL=false
REQUIRE_SUPER_ADMIN_MFA=false
MIN_SUPER_ADMIN_COUNT=1
